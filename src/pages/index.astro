---
import FortuneCookie from "../components/FortuneCookie.svelte";
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>Fortune 4 You | Digital Fortune Cookie</title>
    <meta
      name="description"
      content="Experience the zen of a digital fortune cookie. Crack it open to reveal your wisdom, Chinese lessons, and lucky numbers."
    />
    <meta property="og:title" content="Fortune 4 You" />
    <meta
      property="og:description"
      content="What does the future hold for you? Crack a digital cookie today."
    />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-chinese-red">
    <main
      class="flex flex-col items-center justify-between min-h-[calc(100vh-2rem)] p-4 sm:p-8 md:p-16 w-full max-w-5xl border-[10px] border-chinese-gold m-4 bg-chinese-red shadow-[10px_10px_0px_rgba(0,0,0,0.3)]"
    >
      <header
        class="text-center mb-8 bg-chinese-gold px-6 py-4 sm:px-12 sm:py-6 border-4 border-double border-chinese-red shadow-[4px_4px_0px_rgba(0,0,0,0.2)]"
      >
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-chinese font-bold mb-1 text-chinese-red uppercase tracking-tight"
        >
          Fortune 4 You
        </h1>
        <p
          class="text-chinese-red font-chinese font-bold tracking-[0.2em] uppercase text-xs sm:text-sm border-t-2 border-chinese-red pt-2 mt-2"
        >
          Your daily dose of digital wisdom
        </p>
      </header>

      <div class="flex-grow flex items-center justify-center w-full">
        <FortuneCookie client:load />
      </div>

      <footer
        class="mt-12 text-chinese-gold font-bold text-[10px] sm:text-xs text-center tracking-widest bg-black/20 px-4 py-2 sm:px-8"
      >
        <p>
          &copy; {new Date().getFullYear()} FORTUNE 4 YOU &bull; POWERED BY <a
            href="https://github.com/larryprice/fortune-cookie-api"
            target="_blank"
            rel="noopener noreferrer"
          >
            LARRY PRICE'S API
          </a> &bull;
          <a
            href="https://github.com/s4nj1th/fortune-4-you"
            target="_blank"
            rel="noopener noreferrer">SOURCE CODE</a
          >
        </p>
      </footer>
    </main>
  </body>
</html>
